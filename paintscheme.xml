<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="./paintscheme-stylesheet.xsl"?>
<paintscheme
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="schema.xsd">
  <models>
      <model title="All">
          <primer href="https://www.warhammer.com/en-US/shop/Chaos-Black-Spray-US-2020" brand="Citadel" type="spray" brush="Spray Can">Citadel Chaos Black</primer>
          <shade href="https://www.warhammer.com/en-US/shop/shadey-nuln-oil-18ml-2022" brand="Citadel" type="shade">Citadel Shade Nuln Oil gloss(I didn't find a gloss finish...)</shade>
          <component title="Carapace">
            <base href="https://www.warhammer.com/en-US/shop/b-phoenician-purple-12ml-us-can" brand="Citadel" type="base" brush="Wargamer: Basecoating">Citadel Base Phoenician Purple</base>
            <layer href="https://thearmypainter.com/products/warpaints-fanatic-warpaints-fanatic-alien-purple-wp3128p" brand="Army Painter" practical="Deep Violet" type="Warpaints Fanatic" technique="drybrush">Army Painter Alien Purple</layer>
            <layer href="https://thearmypainter.com/products/warpaints-fanatic-warpaints-fanatic-warlock-magenta-wp3135p" brand="Army Painter" practical="Vivid Purple" type="Warpaints Fanatic" technique="drybrush">Army Painter Warlock Magenta</layer>
          </component>
          <component title="Eyes &amp; Bioweapon Glow">
              <base href="https://monumenthobbies.com/products/pro-acryl-bold-titanium-white" brand="Pro Acryl">Pro Acryl Bold Titanium White</base>
            <layer href="https://www.warhammer.com/en-US/shop/Technical-Tesseract-Glow-2020" brand="Citadel" type="technical">Citadel Technical tessaract glow</layer>
          </component>
          <component title="Teeth &amp; Claws">
            <base href="https://www.warhammer.com/en-US/shop/b-leadbelcher-12ml-us-can" brand="Citadel" type="base" brush="Wargamer: Layering">Citadel Base Leadbelcher</base>
            <layer href="https://www.warhammer.com/en-US/shop/l-ironbreaker-12ml-us-can" brand="Citadel" type="layer">Citadel Layer Ironbreaker</layer>
            <layer href="https://www.warhammer.com/en-US/shop/l-runefang-steel-12ml-us-can" brand="Citadel" type="layer">Citadel Layer Runefang Steel</layer>
          </component>
    </model>
  </models>
</paintscheme>

